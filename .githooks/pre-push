#!/bin/sh
# Git hook: pre-push
# Blocks direct pushes to protected branches (main, develop).
# All changes must go through Pull Requests.

PROTECTED_BRANCHES="main develop"
CURRENT_BRANCH=$(git symbolic-ref HEAD 2>/dev/null | sed 's|refs/heads/||')

for PROTECTED in $PROTECTED_BRANCHES; do
  if [ "$CURRENT_BRANCH" = "$PROTECTED" ]; then
    echo ""
    echo "ERROR: Direct push to '$PROTECTED' is not allowed!"
    echo ""
    echo "Git Flow rules require all changes to go through Pull Requests."
    echo ""
    echo "What to do:"
    if [ "$PROTECTED" = "develop" ]; then
      echo "  1. Create a feature branch: git checkout -b feature/your-feature develop"
      echo "  2. Make your changes and commit"
      echo "  3. Push the feature branch: git push -u origin feature/your-feature"
      echo "  4. Open a Pull Request to 'develop'"
    elif [ "$PROTECTED" = "main" ]; then
      echo "  1. Use a release branch: git checkout -b release/x.y.z develop"
      echo "  2. Or a hotfix branch:   git checkout -b hotfix/description main"
      echo "  3. Open a Pull Request to 'main' after review"
    fi
    echo ""
    exit 1
  fi
done

# Check for .env files being pushed
while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  if [ "$LOCAL_SHA" != "0000000000000000000000000000000000000000" ]; then
    FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || git diff --name-only HEAD~1 HEAD 2>/dev/null)
    if echo "$FILES" | grep -qE "^\.env$|^\.env\.[^e]"; then
      echo ""
      echo "ERROR: Attempting to push .env file with secrets!"
      echo "Remove the .env file from your commit and add it to .gitignore"
      echo ""
      exit 1
    fi
  fi
done

exit 0
