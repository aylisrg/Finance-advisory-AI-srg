# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./finance_advisory.db

# JWT Authentication
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# OpenAI API (for AI advisory features)
API_KEY_OPENAI=sk-your-openai-key-here

# Encryption
ENCRYPTION_KEY=change-me-to-a-32-byte-key-here

# Financial Data API
FINANCIAL_DATA_API_KEY=your-financial-data-api-key
FINANCIAL_DATA_API_URL=https://api.example.com/v1
